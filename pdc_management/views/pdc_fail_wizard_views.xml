<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pdc_fail_wizard_form" model="ir.ui.view">
        <field name="name">pdc.fail.wizard.form</field>
        <field name="model">pdc.fail.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Cheque">
                <sheet>

                    <group>
                        <field name="failure_reason"
                               placeholder="Enter the reason for cancellation..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_fail" type="object"
                            string="Confirm Cancel"
                            class="btn-danger"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>