<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_pdc_cheque" model="ir.sequence">
            <field name="name">PDC Cheque Reference</field>
            <field name="code">pdc.cheque</field>
            <field name="prefix">PDC/%(year)s/%(month)s/</field>
