<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="cron_pdc_update_timeline" model="ir.cron">
            <field name="name">PDC: Update Processing Timeline</field>
            <field name="model_id" ref="model_pdc_cheque"/>
            <field name="state">code</field>
            <field name="code">model._cron_update_processing_timeline()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <record id="cron_pdc_send_alerts" model="ir.cron">
            <field name="name">PDC: Send Due Date Alerts</field>
            <field name="model_id" ref="model_pdc_cheque"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>