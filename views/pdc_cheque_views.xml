<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════
         ENHANCED LIST VIEW
    ══════════════════════════════════════════════════════════════ -->
    <record id="view_pdc_cheque_list" model="ir.ui.view">
        <field name="name">pdc.cheque.tree</field>
        <field name="model">pdc.cheque</field>
        <field name="arch" type="xml">
            <list string="PDC Cheques"
                  decoration-danger="processing_timeline == 'overdue'"
                  decoration-warning="processing_timeline in ('today','7_days')"
                  decoration-info="processing_timeline == '15_days'"
                  decoration-success="status == 'processed'"
                  decoration-muted="status == 'cancelled'">

                <field name="name" string="Reference"/>
                <field name="cheque_number"/>
                <field name="bank_id" string="Bank Account"/>
                <field name="bank_account_number" string="Account Number"/>
                <field name="payee_id" string="Payee"/>
                <field name="amount" widget="monetary" sum="Total"/>
                <field name="days_to_due" string="Days to Due"
                       decoration-danger="days_to_due &lt; 0"
                       decoration-warning="days_to_due &lt;= 7 and days_to_due >= 0"
                       decoration-info="days_to_due &lt;= 15 and days_to_due > 7"/>
                <field name="entered_by" string="Issued By"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="status" string="Status"
                       widget="badge"
                       decoration-danger="status == 'cancelled'"
                       decoration-success="status == 'processed'"
                       decoration-warning="status == 'draft'"
                       decoration-info="status == 'active'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════
         CHEQUE FORM
    ══════════════════════════════════════════════════════════════ -->
    <record id="view_pdc_cheque_form" model="ir.ui.view">
        <field name="name">pdc.cheque.form</field>
        <field name="model">pdc.cheque</field>
        <field name="arch" type="xml">
            <form string="PDC Cheque">
                <header>
                    <button name="action_set_active" type="object"
                            string="Activate" class="btn-primary"
                            invisible="status != 'draft'"/>
                    <button name="action_set_processed" type="object"
                            string="Mark as Processed" class="btn-success"
                            invisible="status not in ('draft', 'active')"/>
                    <button name="action_cancel" type="object"
                            string="Cancel" class="btn-danger"
                            invisible="status in ('processed', 'cancelled')"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,active,processed"/>
                </header>

                <sheet>
                    <!-- ── Alert banners ── -->
                    <div class="alert alert-danger o_alert_banner" role="alert"
                         invisible="processing_timeline != 'overdue'">
                        <h4 class="alert-heading">&#x1F6A8; OVERDUE CHEQUE — IMMEDIATE ACTION REQUIRED!</h4>
                        <p>This cheque is <strong>past its due date</strong> and has
                           <strong>NOT been processed</strong>. Please process it immediately!</p>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="processing_timeline != 'today'">
                        <strong>&#x1F514; DUE TODAY!</strong> This cheque must be processed today.
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="processing_timeline != '7_days'">
                        <strong>&#x26A0;&#xFE0F; Due in 7 days</strong> — Please prepare for processing.
                    </div>

                    <!-- ── Locked banner: shown when cheque is NOT draft ── -->
                    <div class="alert alert-warning d-flex align-items-center gap-2" role="alert"
                         invisible="status == 'draft'">
                        <i class="fa fa-lock fa-lg"/>
                        <span>
                            <strong>This cheque is locked.</strong>
                            All fields are read-only once a cheque is Activated.
                            To make changes, cancel this cheque and create a new one.
                        </span>
                    </div>

                    <div class="alert alert-secondary" role="alert"
                         invisible="status != 'cancelled'">
                        <strong>&#x274C; Cancelled:</strong>
                        <field name="failure_reason" readonly="1" nolabel="1"/>
                    </div>

                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group>
                        <group string="Cheque Details">
                            <!--
                                readonly="status != 'draft'" locks all fields
                                once the cheque leaves Draft state.
                            -->
                            <field name="bank_id"
                                   options="{'no_quick_create': True, 'no_create_edit': True}"
                                   readonly="status != 'draft'"/>
                            <field name="bank_account_number" readonly="1"/>
                            <field name="bank_branch" readonly="1"/>
                            <field name="bank_ifsc" readonly="1"/>
                            <field name="cheque_number" readonly="status != 'draft'"/>
                        </group>
                        <group string="Payee &amp; Amount">
                            <field name="payee_id" required="1" readonly="status != 'draft'"/>
                            <field name="amount" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   required="1"
                                   readonly="status != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="cheque_date" readonly="status != 'draft'"/>
                            <field name="days_to_due" readonly="1"
                                   decoration-danger="days_to_due &lt; 0"
                                   decoration-warning="days_to_due &lt;= 7"
                                   decoration-info="days_to_due &lt;= 15"/>
                        </group>
                    </group>

                    <group>
                        <group string="Record Info">
                            <field name="entered_by" readonly="1"/>
                            <field name="entered_date" readonly="1"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                            <field name="processing_timeline" readonly="1" widget="badge"
                                   decoration-danger="processing_timeline == 'overdue'"
                                   decoration-warning="processing_timeline in ('today','7_days')"
                                   decoration-info="processing_timeline == '15_days'"
                                   decoration-success="processing_timeline == 'processed'"
                                   decoration-muted="processing_timeline == 'cancelled'"/>
                        </group>
                    </group>

                    <!-- ══════════════════════════════════════════════════
                         NOTEBOOK — Scanned Cheque
                    ══════════════════════════════════════════════════════ -->
                    <notebook>
                        <page string="Scanned Cheque" name="scanned_cheque_page">

                            <field name="is_pdf_upload" invisible="1"/>
                            <field name="scanned_cheque_url" invisible="1"/>

                            <!-- Upload only allowed in Draft -->
                            <group string="Upload Cheque Document"
                                   invisible="status != 'draft'">
                                <field name="scanned_cheque"
                                       filename="scanned_cheque_filename"
                                       widget="binary"
                                       string="Upload File"
                                       options="{'accepted_file_types': 'image/*,.pdf'}"/>
                                <field name="scanned_cheque_filename" invisible="1"/>
                            </group>

                            <!-- Read-only notice when locked -->
                            <div class="alert alert-secondary d-flex align-items-center gap-2 mt-2"
                                 invisible="status == 'draft'">
                                <i class="fa fa-lock"/>
                                <span>File upload is disabled once the cheque is Activated.</span>
                            </div>

                            <!-- File name + toggle buttons (always visible if file exists) -->
                            <div class="d-flex align-items-center gap-2 mt-2 ms-1"
                                 invisible="not scanned_cheque">

                                <i class="fa fa-file-pdf-o fa-lg text-danger"
                                   title="PDF document"
                                   invisible="not is_pdf_upload"/>
                                <i class="fa fa-file-image-o fa-lg text-primary"
                                   title="Image file"
                                   invisible="is_pdf_upload"/>

                                <span class="fw-semibold" style="max-width:320px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                                    <field name="scanned_cheque_filename" readonly="1" nolabel="1"/>
                                </span>

                                <button name="action_toggle_image" type="object"
                                        class="btn btn-sm btn-outline-secondary"
                                        title="Show preview"
                                        invisible="show_image">
                                    <i class="fa fa-eye me-1"/> Preview
                                </button>
                                <button name="action_toggle_image" type="object"
                                        class="btn btn-sm btn-secondary"
                                        title="Hide preview"
                                        invisible="not show_image">
                                    <i class="fa fa-eye-slash me-1"/> Hide
                                </button>
                            </div>

                            <!-- Inline image preview -->
                            <div class="mt-3 border rounded p-2 bg-light"
                                 invisible="not show_image or is_pdf_upload">
                                <field name="scanned_cheque" widget="image" readonly="1"
                                       style="max-height:420px; max-width:100%; object-fit:contain; display:block; margin:auto;"/>
                            </div>

                            <!-- PDF open button -->
                            <div class="mt-3 d-flex align-items-center gap-2 p-2 border rounded bg-light"
                                 invisible="not show_image or not is_pdf_upload">
                                <i class="fa fa-info-circle text-primary fa-lg"/>
                                <span class="text-muted">PDF files cannot be previewed inline.</span>
                                <button name="action_open_scanned_cheque" type="object"
                                        class="btn btn-sm btn-outline-primary ms-auto"
                                        title="Open PDF in a new browser tab">
                                    <i class="fa fa-external-link me-1"/> Open PDF in new tab
                                </button>
                            </div>

                        </page>

                        <!-- Notes tab — read-only when not draft -->
                        <page string="Notes" name="notes_page">
                            <field name="notes"
                                   placeholder="Notes / Remarks..."
                                   readonly="status != 'draft'"/>
                        </page>

                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════
         KANBAN VIEW
    ══════════════════════════════════════════════════════════════ -->
    <record id="view_pdc_cheque_kanban" model="ir.ui.view">
        <field name="name">pdc.cheque.kanban</field>
        <field name="model">pdc.cheque</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column">
                <field name="name"/>
                <field name="cheque_number"/>
                <field name="bank_id"/>
                <field name="bank_account_number"/>
                <field name="payee_id"/>
                <field name="amount"/>
                <field name="cheque_date"/>
                <field name="days_to_due"/>
                <field name="status"/>
                <field name="processing_timeline"/>
                <field name="currency_id"/>
                <field name="company_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click"
                             style="position:relative; overflow:hidden;">

                            <div t-if="record.status.value == 'cancelled'"
                                 style="position:absolute;top:0;right:0;background:#dc3545;color:#fff;
                                        font-size:9px;font-weight:700;padding:3px 10px;
                                        border-radius:0 4px 0 8px;letter-spacing:.5px;">
                                CANCELLED
                            </div>
                            <div t-elif="record.status.value == 'processed'"
                                 style="position:absolute;top:0;right:0;background:#28a745;color:#fff;
                                        font-size:9px;font-weight:700;padding:3px 10px;
                                        border-radius:0 4px 0 8px;letter-spacing:.5px;">
                                PROCESSED
                            </div>
                            <div t-elif="record.processing_timeline.value == 'overdue'"
                                 style="position:absolute;top:0;right:0;background:#dc3545;color:#fff;
                                        font-size:9px;font-weight:700;padding:3px 10px;
                                        border-radius:0 4px 0 8px;letter-spacing:.5px;">
                                OVERDUE
                            </div>
                            <div t-elif="record.processing_timeline.value == 'today'"
                                 style="position:absolute;top:0;right:0;background:#fd7e14;color:#fff;
                                        font-size:9px;font-weight:700;padding:3px 10px;
                                        border-radius:0 4px 0 8px;letter-spacing:.5px;">
                                DUE TODAY
                            </div>

                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="cheque_number"/>
                                    </strong>
                                    <small class="text-muted"><field name="name"/></small>
                                </div>
                                <span class="badge rounded-pill"
                                      t-att-class="record.processing_timeline.value == 'overdue'   ? 'bg-danger' :
                                                   record.processing_timeline.value == 'today'     ? 'bg-warning text-dark' :
                                                   record.processing_timeline.value == '7_days'    ? 'bg-info text-dark' :
                                                   record.processing_timeline.value == 'processed' ? 'bg-success' : 'bg-secondary'">
                                    <field name="processing_timeline"/>
                                </span>
                            </div>

                            <div class="o_kanban_record_body">
                                <div><i class="fa fa-university"/> <field name="bank_id"/></div>
                                <div><i class="fa fa-credit-card"/> <field name="bank_account_number"/></div>
                                <div><i class="fa fa-user-o"/> <field name="payee_id"/></div>
                                <div><i class="fa fa-calendar"/> <field name="cheque_date"/></div>
                            </div>

                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <strong><field name="amount" widget="monetary"/></strong>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <span t-if="record.days_to_due.value &lt; 0" class="text-danger fw-bold">
                                        Overdue <field name="days_to_due"/>d
                                    </span>
                                    <span t-elif="record.days_to_due.value == 0" class="text-warning fw-bold">
                                        Due Today
                                    </span>
                                    <span t-else="" class="text-muted">
                                        In <field name="days_to_due"/> days
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════
         SEARCH VIEW
    ══════════════════════════════════════════════════════════════ -->
    <record id="view_pdc_cheque_search" model="ir.ui.view">
        <field name="name">pdc.cheque.search</field>
        <field name="model">pdc.cheque</field>
        <field name="arch" type="xml">
            <search string="Search Cheques">
                <field name="name"          string="Reference"/>
                <field name="cheque_number" string="Cheque Number"/>
                <field name="bank_id"       string="Bank Account"/>
                <field name="payee_id"      string="Payee"/>
                <field name="entered_by"    string="Issued By"/>
                <field name="company_id"    string="Company" groups="base.group_multi_company"/>

                <separator/>
                <filter string="Draft"     name="draft"     domain="[('status','=','draft')]"/>
                <filter string="Active"    name="active"    domain="[('status','=','active')]"/>
                <filter string="Processed" name="processed" domain="[('status','=','processed')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('status','=','cancelled')]"/>

                <separator/>
                <filter string="Overdue"       name="overdue"   domain="[('processing_timeline','=','overdue')]"/>
                <filter string="Due Today"      name="due_today" domain="[('processing_timeline','=','today')]"/>
                <filter string="Due in 7 Days"  name="due_7"    domain="[('processing_timeline','=','7_days')]"/>
                <filter string="Due in 15 Days" name="due_15"   domain="[('processing_timeline','=','15_days')]"/>

                <separator/>
                <filter string="This Month" name="this_month"
                        domain="[('cheque_date','&gt;=', (context_today()).strftime('%Y-%m-01'))]"/>
                <filter string="Next Month" name="next_month"
                        domain="[
                            ('cheque_date','&gt;=', (context_today() + relativedelta(months=1)).strftime('%Y-%m-01')),
                            ('cheque_date','&lt;',  (context_today() + relativedelta(months=2)).strftime('%Y-%m-01'))
                        ]"/>

                <group expand="1" string="Group By">
                    <filter string="Status"       name="group_status"   context="{'group_by': 'status'}"/>
                    <filter string="Bank"         name="group_bank"     context="{'group_by': 'bank_id'}"/>
                    <filter string="Payee"        name="group_payee"    context="{'group_by': 'payee_id'}"/>
                    <filter string="Timeline"     name="group_timeline" context="{'group_by': 'processing_timeline'}"/>
                    <filter string="Cheque Month" name="group_date"     context="{'group_by': 'cheque_date:month'}"/>
                    <filter string="Issued By"    name="group_user"     context="{'group_by': 'entered_by'}"/>
                    <filter string="Company"      name="group_company"  context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════
         PIVOT VIEW
    ══════════════════════════════════════════════════════════════ -->
    <record id="view_pdc_cheque_pivot" model="ir.ui.view">
        <field name="name">pdc.cheque.pivot</field>
        <field name="model">pdc.cheque</field>
        <field name="arch" type="xml">
            <pivot string="Cheque Summary" display_quantity="true">
                <field name="cheque_date" type="row" interval="month"/>
                <field name="bank_id"     type="col"/>
                <field name="amount"      type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════
         GRAPH VIEW
    ══════════════════════════════════════════════════════════════ -->
    <record id="view_pdc_cheque_graph" model="ir.ui.view">
        <field name="name">pdc.cheque.graph</field>
        <field name="model">pdc.cheque</field>
        <field name="arch" type="xml">
            <graph string="Cheques by Month" type="bar" stacked="True">
                <field name="cheque_date" type="row" interval="month"/>
                <field name="status"      type="col"/>
                <field name="amount"      type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════
         WINDOW ACTIONS
    ══════════════════════════════════════════════════════════════ -->

    <record id="action_pdc_cheque_all" model="ir.actions.act_window">
        <field name="name">All Cheques</field>
        <field name="res_model">pdc.cheque</field>
        <field name="view_mode">list,kanban,pivot,graph,form</field>
        <field name="search_view_id" ref="view_pdc_cheque_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first cheque entry!</p>
            <p>Record and track all post-dated cheques here.</p>
        </field>
    </record>

    <record id="action_pdc_cheque_overdue" model="ir.actions.act_window">
        <field name="name">Overdue Cheques</field>
        <field name="res_model">pdc.cheque</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('processing_timeline','=','overdue')]</field>
        <field name="search_view_id" ref="view_pdc_cheque_search"/>
        <field name="context">{'search_default_overdue': 1}</field>
    </record>

    <record id="action_pdc_cheque_due_today" model="ir.actions.act_window">
        <field name="name">Due Today</field>
        <field name="res_model">pdc.cheque</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('processing_timeline','=','today')]</field>
        <field name="search_view_id" ref="view_pdc_cheque_search"/>
    </record>

    <record id="action_pdc_cheque_7days" model="ir.actions.act_window">
        <field name="name">Due in 7 Days</field>
        <field name="res_model">pdc.cheque</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('processing_timeline','=','7_days')]</field>
        <field name="search_view_id" ref="view_pdc_cheque_search"/>
    </record>

    <record id="action_pdc_cheque_15days" model="ir.actions.act_window">
        <field name="name">Due in 15 Days</field>
        <field name="res_model">pdc.cheque</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('processing_timeline','=','15_days')]</field>
        <field name="search_view_id" ref="view_pdc_cheque_search"/>
    </record>

</odoo>